# Учётные данные GREEN-API в приложение не попадают: пользователь вводит
# idInstance и apiTokenInstance в интерфейсе, они хранятся в localStorage
# браузера и уходят в serverless-прокси /api/green-api отдельными заголовками.
#
# Переменные ниже нужны, только если вы захотите задать инстанс по умолчанию
# (например, для демо-стенда). Не коммитьте реальные токены в репозиторий.
VITE_GREEN_API_ID_INSTANCE=
VITE_GREEN_API_TOKEN_INSTANCE=
